# PulseX — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# In CI these are repository secrets rather than a file.

# --- Required ---

# OpenRouter powers summarization and the brief's opening.
# Create a key at openrouter.ai/keys.
OPENROUTER_API_KEY=

# Resend delivers the daily email. Create a key at resend.com/api-keys.
RESEND_API_KEY=

# The sender address. Resend only sends from a domain you have verified
# with it, so a personal Gmail address will not work here. Without a
# domain, onboarding@resend.dev sends to your own Resend account address.
EMAIL_FROM=

# Where the brief is delivered. Any address, no verification needed.
EMAIL_TO=

# --- Optional ---

# Unset, requests go to openrouter/free, which resolves to whatever
# model is free at the time. Set this only to pin one model, and expect
# to revisit it: OpenRouter moves models off the free tier regularly.
# Values must be openrouter/free or end in ':free'; the account has no
# credits, so anything else is rejected at startup.
# OPENROUTER_MODEL=openrouter/free

# How many ranked items the brief carries. Each one costs a request, and
# free accounts are capped at 50 a day, so raising this has a price.
# MAX_BRIEF_ITEMS=15

# Where delivered item ids are recorded, so a run never resends content.
# SEEN_STORE_PATH=data/seen_items.json

# The Firebase service account JSON, inline rather than a path, since the
# only place this runs is a CI runner with no persistent disk. Unset means
# email is the only channel: no Firestore write, no push notification.
# Generate at Firebase Console > Project Settings > Service Accounts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# The FCM topic the app subscribes to. Change only if you run more than
# one environment from one Firebase project.
# FCM_TOPIC=daily_brief
