# PulseX — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# In CI these are repository secrets, not a file.

# OpenRouter powers summarization and the brief's opening.
# Create a key at openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional. Free model slugs are retired from time to time, so override
# this when the default stops resolving.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Resend delivers the daily email. Create a key at resend.com/api-keys.
RESEND_API_KEY=

# The sender must be on a domain you have verified with Resend.
EMAIL_FROM=
EMAIL_TO=

# Optional overrides.
# MAX_BRIEF_ITEMS=15
# SEEN_STORE_PATH=data/seen_items.json
