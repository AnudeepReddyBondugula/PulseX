# PulseX — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required for the pipeline (summarization) and later the Flask backend
# (explain/chat). Get this from console.anthropic.com.
ANTHROPIC_API_KEY=

# Not needed yet — required starting Module A5 (Firestore client wrapper).
# Path to the Firebase service account JSON file (downloaded from Firebase
# Console > Project Settings > Service Accounts).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Not needed yet — required starting Module A10 (Play Developer API client).
# Path to the Google Play service account JSON file (downloaded from Play
# Console > Setup > API access).
PLAY_SERVICE_ACCOUNT_PATH=